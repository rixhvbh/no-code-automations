    {
      "parameters": {
        "jsCode": "// Generate email patterns and verify\nconst item = $input.first().json;\nconst firstName = (item.first_name || '').toLowerCase();\nconst lastName = (item.last_name || '').toLowerCase();\nconst domain = item.company.toLowerCase().replace(/\\s+/g, '').replace(/inc\\.?|llc\\.?|ltd\\.?/gi, '') + '.com';\n\n// Generate top 3 most common patterns\nconst patterns = [\n  `${firstName}.${lastName}@${domain}`,\n  `${firstName}@${domain}`,\n  `${firstName}${lastName}@${domain}`\n];\n\nreturn [{\n  json: {\n    ...item,\n    email_patterns: patterns,\n    email: patterns[0], // Use first pattern as primary\n    email_verified: false\n  }\n}];"
      },
      "id": "generate-patterns",
      "name": "Generate Patterns & Mark Unverified",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apollo.io/v1/people/match?email={{ $json.email }}",
