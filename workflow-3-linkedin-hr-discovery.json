      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Input Validation\nconst inputData = $input.first().json;\nconst requestData = inputData.body || inputData;\n\n// Validate LinkedIn company URL\nif (!requestData.company_url) {\n  throw new Error('company_url is required');\n}\n\nconst linkedinRegex = /^https?:\\/\\/(www\\.)?linkedin\\.com\\/company\\/[a-zA-Z0-9-]+\\/?$/;\nif (!linkedinRegex.test(requestData.company_url)) {\n  throw new Error('Invalid LinkedIn company URL format. Expected: https://www.linkedin.com/company/{slug}/');\n}\n\n// Default filters\nconst jobTitleFilter = requestData.job_title_filter || 'HR|Recruiter|Talent|People Ops';\nconst maxResults = Math.min(requestData.max_results || 50, 100); // Cap at 100\n\nreturn [{\n  json: {\n    company_url: requestData.company_url.trim(),\n    job_title_filter: jobTitleFilter,\n    max_results: maxResults,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "input-validation",
      "name": "Input Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract LinkedIn Company ID from URL\nconst companyUrl = $input.first().json.company_url;\nconst match = companyUrl.match(/\\/company\\/([a-zA-Z0-9-]+)/);\n\nif (!match || !match[1]) {\n  throw new Error('Could not extract company ID from LinkedIn URL');\n}\n\nconst companySlug = match[1];\n\nreturn [{\n  json: {\n    company_url: companyUrl,\n    company_slug: companySlug,\n    job_title_filter: $input.first().json.job_title_filter,\n    max_results: $input.first().json.max_results\n  }\n}];"
      },
      "id": "extract-company-id",
      "name": "Extract LinkedIn Company ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://nubela.co/proxycurl/api/linkedin/company/employees/",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "linkedin_company_profile_url",
              "value": "={{ $json.company_url }}"
            },
            {
              "name": "page_size",
              "value": "={{ $json.max_results }}"
            },
            {
              "name": "employment_status",
              "value": "current"
            },
            {
              "name": "role_search",
              "value": "recruiter,human_resources,talent_acquisition,people_operations"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.proxycurlApiKey }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "fetch-company-employees",
      "name": "Fetch Company Employees",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "proxycurl-api-cred",
          "name": "Proxycurl API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Filter HR Roles with keywords and regex\nconst inputData = $input.first().json;\nconst employees = inputData.employees || [];\n\nconst hrKeywords = [\n  'recruiter', 'talent acquisition', 'talent partner',\n  'hr manager', 'hr business partner', 'hrbp',\n  'people ops', 'people operations', 'people partner',\n  'sourcer', 'talent sourcer', 'recruiting coordinator',\n  'head of talent', 'director of recruiting',\n  'vp of people', 'chief people officer', 'cpo',\n  'human resources', 'talent management'\n];\n\nconst seniorityKeywords = {\n  executive: ['vp', 'vice president', 'chief', 'cpo', 'head of', 'executive'],\n  director: ['director', 'senior director'],\n  manager: ['manager', 'senior manager', 'lead', 'principal'],\n  individual: ['coordinator', 'specialist', 'recruiter', 'sourcer', 'associate']\n};\n\nconst hrEmployees = employees.filter(emp => {\n  const title = (emp.title || '').toLowerCase();\n  return hrKeywords.some(keyword => title.includes(keyword));\n}).map(emp => {\n  const title = (emp.title || '').toLowerCase();\n  \n  // Evaluate seniority\n  let seniority = 'individual';\n  for (const [level, keywords] of Object.entries(seniorityKeywords)) {\n    if (keywords.some(kw => title.includes(kw))) {\n      seniority = level;\n      break;\n    }\n  }\n  \n  return {\n    profile_url: emp.profile_url,\n    full_name: emp.full_name,\n    title: emp.title,\n    seniority: seniority,\n    location: emp.location || 'Unknown'\n  };\n});\n\nif (hrEmployees.length === 0) {\n  return [{\n    json: {\n      success: true,\n      message: 'No HR employees found at this company',\n      hr_contacts: [],\n      total_found: 0\n    }\n  }];\n}\n\nreturn hrEmployees.map(emp => ({ json: emp }));"
      },
      "id": "filter-hr-roles",
      "name": "Filter HR Roles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
