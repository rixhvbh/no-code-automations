    {
      "parameters": {
        "jsCode": "// Calculate Quality Score (0-100)\nconst item = $input.first().json;\n\nlet score = 0;\n\n// Verified email (30 points)\nif (item.email && (item.result === 'valid' || item.email_verified === true)) {\n  score += 30;\n}\n\n// Phone number (15 points)\nif (item.phone || item.person?.phone_numbers?.[0]) {\n  score += 15;\n}\n\n// LinkedIn complete profile (10 points)\nif (item.profile_complete || item.skills_count > 5) {\n  score += 10;\n}\n\n// Company size large >500 (10 points)\nif (item.person?.organization?.estimated_num_employees > 500) {\n  score += 10;\n}\n\n// Seniority scoring\nif (item.seniority === 'executive') score += 15;\nelse if (item.seniority === 'director') score += 10;\nelse if (item.seniority === 'manager') score += 5;\n\n// HR role exact match (10 points)\nconst title = (item.title || '').toLowerCase();\nif (title.includes('hr') || title.includes('talent') || title.includes('people')) {\n  score += 10;\n}\n\n// Recent activity (5 points) - assume true if profile exists\nif (item.linkedin_url) {\n  score += 5;\n}\n\nreturn [{\n  json: {\n    full_name: item.full_name,\n    email: item.email || item.email_patterns?.[0] || 'Not found',\n    phone: item.phone || item.person?.phone_numbers?.[0] || 'Not found',\n    title: item.title,\n    company: item.company || item.person?.organization?.name || 'Unknown',\n    linkedin_url: item.linkedin_url,\n    seniority: item.seniority,\n    quality_score: score,\n    email_verified: item.result === 'valid' || false,\n    skills_count: item.skills_count || 0,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "calculate-quality-score",
      "name": "Calculate Quality Score",
      "type": "n8n-nodes-base.code",
