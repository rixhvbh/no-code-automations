    {
      "parameters": {
        "jsCode": "// Parse contact info from profile\nconst profile = $input.first().json;\n\nconst email = profile.email || null;\nconst phone = profile.phone_numbers?.[0] || null;\nconst firstName = profile.first_name || '';\nconst lastName = profile.last_name || '';\nconst headline = profile.headline || '';\nconst summary = profile.summary || '';\nconst experiences = profile.experiences || [];\nconst currentCompany = experiences.find(exp => !exp.ends_at)?.company || 'Unknown';\nconst skills = profile.skills || [];\n\nreturn [{\n  json: {\n    full_name: profile.full_name,\n    first_name: firstName,\n    last_name: lastName,\n    title: $input.first().json.title,\n    seniority: $input.first().json.seniority,\n    email: email,\n    phone: phone,\n    linkedin_url: profile.public_identifier ? `https://linkedin.com/in/${profile.public_identifier}` : $input.first().json.profile_url,\n    company: currentCompany,\n    headline: headline,\n    skills_count: skills.length,\n    experience_years: experiences.length,\n    profile_complete: !!email && !!phone\n  }\n}];"
      },
      "id": "parse-contact-info",
      "name": "Parse Contact Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
