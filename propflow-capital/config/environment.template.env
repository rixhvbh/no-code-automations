# PropFlow Capital - Real Estate Deal Flow Engine
# Environment Configuration Template

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=propflow_capital
DATABASE_USER=propflow_user
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL=true

# ========================================
# N8N CONFIGURATION
# ========================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=your_encryption_key_here

# Webhook URLs
WEBHOOK_URL_PROCESSING_LAYER=https://n8n.propflow.com/webhook/property-deduplication
WEBHOOK_URL_EMAIL_VERIFICATION=https://n8n.propflow.com/webhook/email-verification
WEBHOOK_URL_ALERT_DISTRIBUTION=https://n8n.propflow.com/webhook/alert-distribution

# ========================================
# SCRAPING & PROXY SERVICES
# ========================================
# BrightData / Oxylabs Proxy Configuration
PROXY_SERVICE=brightdata
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
PROXY_HOST=brd.superproxy.io
PROXY_PORT=22225

# 2Captcha (CAPTCHA Solving)
CAPTCHA_API_KEY=your_2captcha_api_key

# ========================================
# EMAIL DISCOVERY SERVICES
# ========================================
# Hunter.io
HUNTER_IO_API_KEY=your_hunter_io_api_key

# Apollo.io
APOLLO_IO_API_KEY=your_apollo_io_api_key

# Clearbit
CLEARBIT_API_KEY=your_clearbit_api_key

# ========================================
# EMAIL VERIFICATION SERVICES
# ========================================
# NeverBounce
NEVERBOUNCE_API_KEY=your_neverbounce_api_key

# Debounce.io
DEBOUNCE_IO_API_KEY=your_debounce_io_api_key

# ZeroBounce
ZEROBOUNCE_API_KEY=your_zerobounce_api_key

# ========================================
# PHONE LOOKUP SERVICES
# ========================================
# TrueCaller
TRUECALLER_API_KEY=your_truecaller_api_key

# NumVerify
NUMVERIFY_API_KEY=your_numverify_api_key

# ========================================
# LINKEDIN & SOCIAL DATA
# ========================================
# Proxycurl (LinkedIn Data)
PROXYCURL_API_KEY=your_proxycurl_api_key

# ========================================
# BUSINESS INTELLIGENCE
# ========================================
# Dun & Bradstreet
DNB_API_KEY=your_dnb_api_key
DNB_API_SECRET=your_dnb_api_secret

# ========================================
# AI / ANALYSIS SERVICES
# ========================================
# OpenAI (GPT-4 Analysis)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# ========================================
# CRM & STORAGE SERVICES
# ========================================
# Airtable
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID_PROPERTIES=app_your_properties_base_id
AIRTABLE_BASE_ID_CONTACTS=app_your_contacts_base_id
AIRTABLE_BASE_ID_DEALS=app_your_deals_base_id

# Google Sheets
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY=your_google_sheets_private_key
GOOGLE_SHEETS_DEALS_ID=your_google_sheets_spreadsheet_id

# ========================================
# COMMUNICATION SERVICES
# ========================================
# Twilio (SMS Alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15125559999

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=alerts@propflowcapital.com
SENDGRID_FROM_NAME=PropFlow Capital

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#deal-alerts

# ========================================
# ZAPIER & INTEGRATIONS
# ========================================
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR/WEBHOOK/

# ========================================
# MONITORING & LOGGING
# ========================================
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here
ERROR_REPORTING=true

# ========================================
# RATE LIMITING & PERFORMANCE
# ========================================
MAX_CONCURRENT_SCRAPES=5
SCRAPE_DELAY_MS=2000
EMAIL_VERIFICATION_BATCH_SIZE=100
API_RATE_LIMIT_PER_MINUTE=60

# ========================================
# SECURITY
# ========================================
JWT_SECRET=your_jwt_secret_here
API_KEY=your_internal_api_key_here
ALLOWED_ORIGINS=https://propflow.app,https://admin.propflow.app

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_AUTO_ALERTS=true
ENABLE_AUTO_CRM_SYNC=true
ENABLE_GPT_ANALYSIS=true
ENABLE_LINKEDIN_ENRICHMENT=true
