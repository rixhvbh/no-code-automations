# ========================================
# IBOVI SYSTEM - ENVIRONMENT VARIABLES
# ========================================

# ============ DATABASE ============
DATABASE_URL=postgresql://user:password@localhost:5432/ibovi_candidates
REDIS_URL=redis://localhost:6379
DYNAMODB_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============ SCRAPING ============
# Proxy Services
BRIGHTDATA_PROXY_URL=http://brd-customer-xxx:xxx@brd.superproxy.io:22225
OXYLABS_PROXY_URL=http://customer-xxx:xxx@pr.oxylabs.io:7777
SMARTPROXY_PROXY_URL=http://user-xxx:xxx@gate.smartproxy.com:7000

# CAPTCHA Services
TWOCAPTCHA_API_KEY=your_2captcha_api_key
ANTICAPTCHA_API_KEY=your_anticaptcha_api_key

# Rate Limiting
SCRAPER_MAX_CONCURRENT=5
SCRAPER_RATE_LIMIT_MS=2000
SCRAPER_MAX_RETRIES=3

# ============ ENRICHMENT APIs ============
# Apollo.io
APOLLO_API_KEY=your_apollo_api_key

# Clearbit
CLEARBIT_API_KEY=your_clearbit_api_key

# Hunter.io
HUNTER_API_KEY=your_hunter_api_key

# Proxycurl (LinkedIn enrichment)
PROXYCURL_API_KEY=your_proxycurl_api_key

# Clay.com
CLAY_API_KEY=your_clay_api_key

# RocketReach
ROCKETREACH_API_KEY=your_rocketreach_api_key

# ============ VERIFICATION ============
# Email Verification
ZEROBOUNCE_API_KEY=your_zerobounce_api_key
NEVERBOUNCE_API_KEY=your_neverbounce_api_key
DEBOUNCE_API_KEY=your_debounce_api_key

# Phone Verification
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
NUMVERIFY_API_KEY=your_numverify_api_key

# ============ STORAGE & DELIVERY ============
# Google Sheets
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#candidates

# ATS Integration
BULLHORN_CLIENT_ID=your_bullhorn_client_id
BULLHORN_CLIENT_SECRET=your_bullhorn_client_secret
GREENHOUSE_API_KEY=your_greenhouse_api_key
LEVER_API_KEY=your_lever_api_key

# ============ MONITORING ============
# Sentry
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# DataDog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# ============ n8n CONFIGURATION ============
N8N_HOST=http://localhost:5678
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ============ GENERAL SETTINGS ============
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
ENABLE_MONITORING=true
ENABLE_SLACK_NOTIFICATIONS=true

# ============ PROCESSING LIMITS ============
MAX_CANDIDATES_PER_BATCH=1000
MAX_ENRICHMENT_RETRIES=2
DEDUPLICATION_SIMILARITY_THRESHOLD=0.85
DATA_QUALITY_MIN_SCORE=60

# ============ COST CONTROLS ============
MAX_API_COST_PER_DAY=100.00
ALERT_THRESHOLD_PERCENTAGE=80
ENABLE_COST_TRACKING=true
