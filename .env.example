# Medical Device Competitive Intelligence Platform
# Environment Configuration

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_PASSWORD=change_this_to_a_secure_password_123

# ============================================================================
# N8N CONFIGURATION
# ============================================================================
N8N_USER=admin
N8N_PASSWORD=change_this_to_a_secure_password_456
N8N_HOST=n8n.yourdomain.com

# ============================================================================
# REQUIRED API KEYS
# ============================================================================

# OpenAI (GPT-4 for analysis and report generation)
# Get from: https://platform.openai.com/api-keys
# Cost: ~$200-500/month
OPENAI_API_KEY=sk-your-key-here

# Crunchbase (Funding data)
# Get from: https://www.crunchbase.com/products/api
# Cost: $299-999/month
CRUNCHBASE_API_KEY=your-key-here

# Apollo.io (Company enrichment)
# Get from: https://www.apollo.io/api
# Cost: $99-199/month
APOLLO_API_KEY=your-key-here

# ============================================================================
# RECOMMENDED API KEYS
# ============================================================================

# Hunter.io (Email discovery)
# Get from: https://hunter.io/api
# Cost: $49-149/month
HUNTER_API_KEY=

# Clearbit (Company firmographic data)
# Get from: https://clearbit.com/api
# Cost: $99-299/month
CLEARBIT_API_KEY=

# RocketReach (Executive contact data)
# Get from: https://rocketreach.co/api
# Cost: $99-299/month
ROCKETREACH_API_KEY=

# PDFShift (HTML to PDF conversion for reports)
# Get from: https://pdfshift.io
# Cost: $9-49/month
PDFSHIFT_API_KEY=

# ============================================================================
# GOOGLE DRIVE (for report storage)
# ============================================================================
# Create folder in Google Drive and get the folder ID from URL
# Example: https://drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Client email for receiving reports
CLIENT_EMAIL=client@medtechinsights.com

# Admin email for error notifications
ADMIN_EMAIL=admin@yourdomain.com

# ============================================================================
# SLACK CONFIGURATION
# ============================================================================
# Slack OAuth token is configured in n8n UI
# Create app at: https://api.slack.com/apps
# Required scopes: chat:write, channels:read

# ============================================================================
# OPTIONAL SMTP (if not using SendGrid)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to git (it's in .gitignore)
# 3. Rotate API keys every 90 days
# 4. Use strong, unique passwords for database and n8n
# 5. Total monthly cost for all APIs: ~$1,000-3,000 depending on tiers
