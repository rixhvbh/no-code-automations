      },
      "id": "sync-to-sheets",
      "name": "Sync to Google Sheets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/delivery/slack",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "candidates",
              "value": "={{ $json.candidates }}"
            },
            {
              "name": "summary",
              "value": "={{ $json.stats }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-slack",
      "name": "Send Slack Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2450, 500]
    },
    {
      "parameters": {
        "functionCode": "// Final Summary\nconst candidates = $json.candidates || [];\nconst config = $node['Initialize Orchestrator'].json.config;\nconst execution = $node['Initialize Orchestrator'].json.execution;\n\nconst summary = {\n  success: true,\n  executionId: execution.executionId,\n  startTime: execution.startTime,\n  endTime: new Date().toISOString(),\n  platforms: config.platforms,\n  totalCandidates: candidates.length,\n  highQualityCandidates: candidates.filter(c => c.overall_quality_score >= 80).length,\n  verifiedEmails: candidates.filter(c => c.email_verified).length,\n  message: `Successfully processed ${candidates.length} candidates from ${config.platforms.length} platforms`,\n};\n\nconsole.log('IBOVI Orchestration Complete', summary);\n\nreturn [{ json: summary }];"
      },
      "id": "create-summary",
      "name": "Create Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2650, 400]
    },
    {
      "parameters": {
