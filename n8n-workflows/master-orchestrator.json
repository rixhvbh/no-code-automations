{
  "name": "IBOVI Master Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ibovi/orchestrator",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [250, 300],
      "webhookId": "ibovi-orchestrator"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cron Trigger (Every 6 hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 500]
    },
    {
      "parameters": {
        "functionCode": "// Master Orchestrator Function\nconst inputData = $input.first().json;\nconst requestData = inputData.body || inputData;\n\n// Configuration\nconst config = {\n  platforms: requestData.platforms || ['indeed_us', 'indeed_uk', 'linkedin'],\n  searchQuery: requestData.searchQuery || 'software engineer',\n  location: requestData.location || 'Remote',\n  maxResults: requestData.maxResults || 100,\n  minQualityScore: requestData.minQualityScore || 70,\n  enableVerification: requestData.enableVerification !== false,\n  enableEnrichment: requestData.enableEnrichment !== false,\n  deliverToSheets: requestData.deliverToSheets !== false,\n  deliverToSlack: requestData.deliverToSlack !== false,\n};\n\n// Log orchestration start\nconsole.log('IBOVI Master Orchestrator Started', config);\n\n// Create workflow execution metadata\nconst execution = {\n  executionId: $execution.id,\n  startTime: new Date().toISOString(),\n  config: config,\n  status: 'initialized',\n  platforms: config.platforms,\n};\n\nreturn [{\n  json: {\n    success: true,\n    execution: execution,\n    config: config,\n  }\n}];"
      },
      "id": "init-orchestrator",
      "name": "Initialize Orchestrator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "platform",
              "name": "platform",
              "value": "={{ $json.platforms }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "split-platforms",
      "name": "Split Into Platforms",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [650, 400]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-platforms",
      "name": "Loop Through Platforms",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3.1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "functionCode": "// Scraping Function\nconst platform = $json.platform;\nconst config = $node['Initialize Orchestrator'].json.config;\n\nconsole.log(`Scraping platform: ${platform}`);\n\n// In production, this would call the actual scraper service\n// For now, return mock data structure\nconst scrapingJob = {\n  platform: platform,\n  searchQuery: config.searchQuery,\n  location: config.location,\n  maxResults: config.maxResults,\n  status: 'pending',\n  startTime: new Date().toISOString(),\n};\n\nreturn [{\n  json: {\n    job: scrapingJob,\n    webhookUrl: `http://localhost:3000/api/scrape/${platform}`,\n  }\n}];"
      },
      "id": "prepare-scrape",
      "name": "Prepare Scraping Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhookUrl }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "searchQuery",
              "value": "={{ $json.job.searchQuery }}"
            },
            {
              "name": "location",
              "value": "={{ $json.job.location }}"
            },
            {
              "name": "maxResults",
              "value": "={{ $json.job.maxResults }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "call-scraper",
      "name": "Call Scraper API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "functionCode": "// Process scraped candidates\nconst scrapedData = $json;\nconst candidates = scrapedData.candidates || [];\n\nconsole.log(`Processing ${candidates.length} candidates`);\n\n// In production, this calls the DataProcessor service\n// Mock processing for now\nconst processed = candidates.map(candidate => ({\n  ...candidate,\n  processed: true,\n  processedAt: new Date().toISOString(),\n}));\n\nreturn [{\n  json: {\n    candidates: processed,\n    stats: {\n      total: candidates.length,\n      processed: processed.length,\n    },\n  }\n}];"
      },
      "id": "process-candidates",
      "name": "Process Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "enable-verification",
              "leftValue": "={{ $node['Initialize Orchestrator'].json.config.enableVerification }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-verification",
      "name": "Check if Verification Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [1650, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/verify",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "candidates",
              "value": "={{ $json.candidates }}"
            }
          ]
        },
        "options": {}
      },
      "id": "verify-emails",
      "name": "Verify Emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1850, 300]
    },
